{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Klarwert/Klarwert-Community-Rules/schema/bank-profile.schema.json",
  "title": "Klarwert Community Bank Profile",
  "description": "Beschreibt AUSSCHLIESSLICH die Struktur eines Bank-CSV-Exports (Spalten, Trennzeichen, Formate). Sample-Zeilen sind IMMER synthetisch erfundene Beispieldaten, niemals echte exportierte Kontodaten.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "country", "status", "delimiter", "encoding", "date_format", "decimal_format", "headers", "column_map", "sample_rows"],
  "properties": {
    "name": {
      "type": "string",
      "description": "Menschenlesbarer Name, MUSS exakt dem Dateinamen (slugifiziert) entsprechen.",
      "minLength": 1,
      "maxLength": 80
    },
    "country": {
      "type": "string",
      "description": "ISO-3166-1-alpha-2-Ländercode, für den dieses CSV-Format gilt.",
      "pattern": "^[A-Z]{2}$"
    },
    "status": { "type": "string", "enum": ["active", "deprecated"] },
    "delimiter": { "type": "string", "enum": [",", ";", "\t"] },
    "encoding": { "type": "string", "enum": ["utf-8", "windows-1252"] },
    "date_format": { "type": "string", "maxLength": 20 },
    "decimal_format": { "type": "string", "enum": ["de", "en"] },
    "headers": {
      "type": "array",
      "items": { "type": "string", "maxLength": 100 },
      "minItems": 1,
      "maxItems": 40
    },
    "column_map": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "string", "maxLength": 100 }
    },
    "import_all_columns": { "type": "boolean" },
    "extract_counterparty_from_purpose": { "type": "boolean" },
    "sample_rows": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "array",
        "items": { "type": "string", "maxLength": 200 }
      }
    }
  }
}
